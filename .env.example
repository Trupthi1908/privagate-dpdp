# Local SLM / Ollama endpoint (defaults to http://localhost:11434/api/generate)
OLLAMA_API_URL=http://localhost:11434/api/generate
LOCAL_SLM_MODEL=llama3:latest

# Gateway Configuration
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0

